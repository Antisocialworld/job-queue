generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  pending
  processing
  succeeded
  failed
  dead
}

enum EmailSendState {
  sending
  sent
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(pending)
  attempts       Int       @default(0)
  maxAttempts    Int
  lastError      String?
  runAt          DateTime  @default(now())
  startedAt      DateTime?
  lastHeartbeat  DateTime?
  finishedAt     DateTime?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  // Optimistic concurrency for the claim. Incremented by the atomic claim, so
  // the pair (leaseVersion, workerInstanceId) identifies exactly one claim.
  // A worker whose completion write is guarded on its own leaseVersion and
  // matches 0 rows knows it was reclaimed out from under it.
  leaseVersion        Int     @default(0)
  workerInstanceId    String?

  // Set when a possible duplicate real send was detected. Deliberately NOT
  // auto-remediated: the risk is recorded for a human to review, not undone.
  possibleDuplicateSend Boolean @default(false)

  emailLog       EmailLog?

  @@index([status, runAt])
  @@index([status, lastHeartbeat])
  @@map("Job")
}

model EmailLog {
  id        String         @id @default(cuid())
  jobId     String         @unique
  state     EmailSendState @default(sending)
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("EmailLog")
}