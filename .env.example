# job-queue — environment configuration
#
# COPY THIS FILE TO `.env` and fill in every value by hand.
# Real credentials are NEVER committed, and NEVER generated by tooling.
# `.env` is already gitignored.

# --- Database (PostgreSQL via local Docker, see docker-compose.yml) ---
# Example shape for a local PostgreSQL instance (this project uses port 5434):
# DATABASE_URL=postgresql://user:password@localhost:5434/job_queue
# Password for the local docker Postgres, read by docker-compose.yml:
# POSTGRES_PASSWORD=your-password-here

# --- Gmail SMTP (real email sending) ---
# A Google account with an App Password created at https://myaccount.google.com/apppasswords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your16characterapppassword

# --- Optional tuning (values shown are the built-in defaults) ---
# MAX_ATTEMPTS=5
# WORKER_CONCURRENCY=3
# POLL_INTERVAL_MS=1000
# BASE_DELAY_MS=5000
# STUCK_TIMEOUT_MS=60000
# Hard ceiling on a single job attempt, measured from its real startedAt and
# enforced REGARDLESS of heartbeat. A heartbeat proves the process is alive,
# not that the work is progressing, so this is what catches a job stuck in an
# infinite loop or a hung call that never times out. A real Gmail send
# finishes in well under 5s, so 20s is generous headroom. Must be <=
# STUCK_TIMEOUT_MS or the config refuses to load.
# MAX_JOB_DURATION_MS=20000
# Worker heartbeat cadence. Defaults to STUCK_TIMEOUT_MS/6 (10s at the default
# timeout), so a live worker survives ~6 missed beats before the sweep reclaims
# its job. Keep this well under STUCK_TIMEOUT_MS/3 if you override it.
# HEARTBEAT_INTERVAL_MS=10000
# How long a worker waits for the peer that won an EmailLog insert race to
# record a real send, before calling the outcome genuinely unknown. Only
# reached when two workers race the same job. The loser of the insert race is
# usually the current lease-holder, and it is the only worker allowed to write
# the terminal status, so it waits briefly to see whether the peer really
# delivered instead of abandoning the job. Short enough that a worker slot is
# never held hostage.
# DUPLICATE_SEND_CONFIRM_MS=2000

# --- Test-only overrides for the break-it tests, leave commented for normal use ---
# worker/email.ts only skips the real Gmail call when this is exactly "1"
# WORKER_TEST_DISABLE_SEND=1
# WORKER_TEST_SLEEP_MS=300