# job-queue — environment configuration
#
# COPY THIS FILE TO `.env` and fill in every value by hand.
# Real credentials are NEVER committed, and NEVER generated by tooling.
# `.env` is already gitignored.

# --- Database (PostgreSQL via local Docker, see docker-compose.yml) ---
# Example shape for a local PostgreSQL instance:
# DATABASE_URL=postgresql://user:password@localhost:5432/job_queue

# --- Gmail SMTP (real email sending) ---
# A Google account with an App Password created at https://myaccount.google.com/apppasswords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your16characterapppassword

# --- Optional tuning (values shown are the built-in defaults) ---
# MAX_ATTEMPTS=5
# WORKER_CONCURRENCY=3
# POLL_INTERVAL_MS=1000
# BASE_DELAY_MS=5000
# STUCK_TIMEOUT_MS=60000